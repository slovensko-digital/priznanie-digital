	<xsl:template name="dtc_rodneCislo">
		<xsl:param name="isPrefix" />
		<xsl:param name="stringToSplit" />
		<xsl:variable name="prefixString" select="substring($stringToSplit, 1, 6)"/>
		<xsl:variable name="suffixString" select="substring($stringToSplit, 7, string-length($stringToSplit) - 6)"/>
		<xsl:choose>
			<xsl:when test="string(true()) = string($isPrefix)">
				<xsl:value-of select="$prefixString" />
			</xsl:when>
			<xsl:otherwise>
				<xsl:value-of select="$suffixString" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
	<xsl:template name="dtc_formatDate">
		<xsl:param name="stringToFormat" />
		<xsl:choose>
			<xsl:when test="string-length($stringToFormat) = 10 and substring($stringToFormat, 5, 1) = '-' and substring($stringToFormat, 8, 1) = '-'">
				<xsl:variable name="year" select="substring($stringToFormat, 1, 4)" />
				<xsl:variable name="month" select="substring($stringToFormat, 6, 2)" />
				<xsl:variable name="day" select="substring($stringToFormat, 9, 2)" />
				<xsl:value-of select="$day" />
				<xsl:value-of select="'.'" />
				<xsl:value-of select="$month" />
				<xsl:value-of select="'.'" />
				<xsl:value-of select="$year" />
			</xsl:when>
			<xsl:otherwise>
				<xsl:value-of select="$stringToFormat" />
			</xsl:otherwise>
		</xsl:choose>
	</xsl:template>
</xsl:stylesheet>
