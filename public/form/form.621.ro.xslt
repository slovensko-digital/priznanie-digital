            var t66 = Number($("#t66").val());
            var t69 = Number($("#t69").val());
            var t95 = Number($("#t95").val());
            var t146 = Number($("#t146").val());


            if (!$("#cbNerezident").attr("checked")) {
                return cislo();
            } else {
                if (((t41 > 0 || t42 > 0) && (t39 == 0 && t40 == 0)))
                    return cislo();
                 else if (t146 > 0 && (t36 + t95 + t58 + t66 + t69) / t146 >= 0.9)
                    return cislo();
                else if ((t146 > 0 && (t36 + t95 + t58 + t66 + t69) / t146 < 0.9) && ($("#nerezidentOd").val() !== "01.01.2024" || $("#nerezidentDo").val() !== "31.12.2024"))
                    return "";
                else if ((t146 > 0 && (t36 + t95 + t58 + t66 + t69) / t146 < 0.9) && ($("#nerezidentOd").val() == "01.01.2024" && $("#nerezidentDo").val() == "31.12.2024"))
                    return 0;
                else if (t146 <= 0)
                    return 0;
            }

            function cislo() {
                var validChildren = [];

                //cyklus prechádzajúci dietatmi
                $("[id^='layoutRow40037']").each(function () {
                    var element = $(this).find("[id^='r33RodCislo_2a'][value!='']");
                    var result = DietaInfo($(element), 2024);
                    if (result != null) {
                        result.months = [];
                        var allAreChecked = $(this).find("[id^='cbM00']").is(':checked');

                        //cyklus prechádzajúci všetkými mesiacmi daného dietata
                        $(this).find("[id^='cbM']").each(function () {
                            var checked = (allAreChecked || $(this).is(":checked"));

                            if (checked && result.months.length != 0) {
                                var month = result.months.length;

                                //vráti rozdiel medzi zaškrtnutym mesiacom (datumom) a vekom dietata v tom mesiaci
                                var rozdiel = DateDiffInYears(result.datum, new Date(2024, month - 2, 31));

                                if (rozdiel == -1 && result._monthBirth == month) {
                                    result.months.push(true); //mesiac narodania dietata
                                }
                                else if (0 <= rozdiel && rozdiel <= 25) {
                                    if (rozdiel >= 25 && result._monthBirth < month) {
                                        result.months.push(false); //mesiac dovrsenia 25 rokov dietata 
                                    } else {
                                        result.months.push(true); //medzi 0 - 25 rokov
                                    }
                                } 
                                else {
                                    result.months.push(false); //moc starý alebo nenarodený
                                }
                            } 
                            else {
                                result.months.push(false); //nezasktnuty mesiac
                            }
                        });

                        validChildren.push(result); 
                    }
                });

               //vráti počet detí v danom mesiaci
                function getNumberOfChildsInMonth(monthIndex) {
                    var numberOfChilds = 0;
                    for (var i = 0; i < validChildren.length; i++) {
                        if (validChildren[i].months[monthIndex]) {
                            numberOfChilds += 1;
                        }
                    }
                    return numberOfChilds;
                }

                //získame pole s počtami detí v jednotlivých mesiacoch a pole s kategóriami mesiacodetí
                let numberOfChildsInMonths = [];
                let numberCategories = [];
                for (var i = 1; i <= 12; i++) {
                    let numberOfChildsInMonth = getNumberOfChildsInMonth(i);
                    numberOfChildsInMonths.push(numberOfChildsInMonth);
                    if (numberCategories.indexOf(numberOfChildsInMonth) == -1) {
                        numberCategories.push(numberOfChildsInMonth)
                    }
                }


                //rozdelí mesiace do skupín podla rovnakého počtu detí
                monthGroups = [];

                for (var i = 0; i < numberCategories.length; i++) {
                    var pocetDeti = numberCategories[i];
                    monthGroups.push([]);
                    for (var j = 0; j < 12; j++) {
                        if (numberOfChildsInMonths[j] == pocetDeti) {
                            monthGroups[i].push(j + 1)
                        }
                    }
                }


                var sumaDB = 0;

                //cyklus prechádzjúci všetkými rozdelenými skupinami mesiacov
                for (var groupIndex = 0; groupIndex < monthGroups.length; groupIndex++) {

                    var pocetMesiacovVSkupine = monthGroups[groupIndex].length; //pocet mesiacov v skupine mesiacov
                    var partialSumaDB = 0;

                    //cyklus prechádzjúci všetkými mesiacmi v danej skupine mesiacov
                    for (var monthIndex = 0; monthIndex < pocetMesiacovVSkupine; monthIndex++) {
                        var numberOfChilds = 0;
                        for (var childIndex = 0; childIndex < validChildren.length; childIndex++) {
                            var month = monthGroups[groupIndex][monthIndex];

                            if (validChildren[childIndex].months[month]) {
                                numberOfChilds += 1;
                                var date = new Date(validChildren[childIndex].datum)

                                var rozdiel = DateDiffInYears(date, new Date(2024, month - 1, 0));
                               
                                if (rozdiel < 18) {
                                    partialSumaDB += 140.00;
                                }
                                else if (rozdiel < 25) {
                                    partialSumaDB += 50.00;
                                }
                            }
                        }
                    }

                    //vysku limitu beriem podla toho či je zaškrtnuty "Uplatňujem postup podľa §33 ods. 8 zákona" 
                    if ($("#cb34_Uplatnujem").attr("checked")) {
                        var limit = Number($("#t116a").val());
                    } else {
                        var limit38 = Number($("#r38").val());
                        var limit45 = Number($("#t45").val());
                        var limit = limit38 + limit45;
                    }

                  
                    limit = (Big(Number(limit))).round(2, 1) * 1;
                    switch (numberOfChilds) {
                        case 0:
                            break;
                        case 1:
                            limit = limit * 0.20;
                            break;
                        case 2:
                            limit = limit * 0.27;
                            break;
                        case 3:
                            limit = limit * 0.34;
                            break;
                        case 4:
                            limit = limit * 0.41;
                            break;
                        case 5:
                            limit = limit * 0.48;
                            break;
                        default:
                            limit = limit * 0.55;
                    }

                    limit = (Big(Number(limit))).round(2) * 1;

                    //v prípade že v danej skupine mesiacov niesu zahrnute vsetky mesiace roka, musíme vypočítat alikvotnu ciastku limitu vzhladom na počet mesiacov v skupine
                    if (pocetMesiacovVSkupine != 12) {
                        var pom = Big(limit).div(12).round(2, 1); //deleno pocet mesiacov(12)
                        limit = (pom) * pocetMesiacovVSkupine;
                        limit = (Big(Number(limit))).round(2) * 1;
                    }

                    partialSumaDB = partialSumaDB > limit ? limit : partialSumaDB;

                    sumaDB += partialSumaDB;
                }

                sumaDB = Big(Number(sumaDB) || 0).round(2, 1);
                return sumaDB.toFixed(2);
            }


            //GlobalFunction - vrat info o dietati 
            function DietaInfo(dieta, rok) {
                var year = rok;
                var parent = dieta.closest(".layoutRow");
                var rc1 = dieta.val();
                var rc2 = parent.find("[id^='r33RodCislo_2b']").val();
                var checked = parent.find("[id^='cbM']:checked");
                var monthGroups = {
                    _1: false,
                    _2: false,
                    _3: false,
                    _4: false,
                    _5: false,
                    _6: false,
                    _7: false,
                    _8: false,
                    _9: false,
                    _10: false,
                    _11: false,
                    _12: false,
                }
                var dietaInfo = {
                    datum: null,
                    _monthBirth: 0,
                    _12: false,
                    _1to3: 0,
                    _4to12: 0,
                    _4toBirth: 0,
                    _birthTo12: 0,
                    _1to12_2021: 0, //2021
                    _1toBirth_2021: 0, //2021
                    _birthTo12_2021: 0, //2021
                    _1to12_2022: 0, //2022
                    _1to6_2022: 0, //2022
                    _7to12_2022: 0, //2022
                    _1to6Birth_2022: 0, //2022
                    _7to12Birth_2022: 0, //2022
                    _birthTo12_2022: 0, //2022
                    _birthTo6_2022: 0, //2022
                    _birth7To12_2022: 0, //2022
                    _1toBirth_2022: 0 //2022
                };
                if (checked.length == 0) return null;

                if (rc2.length == 4) {
                    if (rc1.length == 6) {
                        //je to rodne cislo
                        var rok = Number(rc1.substr(0, 2));
                        var mesiac = Number(rc1.substr(2, 2));
                        var den = Number(rc1.substr(4, 2));

                        if (isNaN(rok) || isNaN(mesiac) || isNaN(den)) return null;

                        if (rok > 90) rok += 1900;
                        else rok += 2000;
                        var diff = year - rok;
                        if (diff < 0 || diff > 25) return null;

                        if (mesiac >= 50 && mesiac <= 62) mesiac -= 50;
                        if (mesiac > 12) return null;

                        if (den > 31) return null;

                        dietaInfo.datum = new Date(rok, mesiac - 1, den);
                    } else if (rc1.length == 4) {
                        //je to datum
                        var rok = Number(rc2);
                        var mesiac = Number(rc1.substr(2, 2));
                        var den = Number(rc1.substr(0, 2));

                        if (isNaN(rok) || isNaN(mesiac) || isNaN(den)) return null;
                        var diff = year - rok;
                        if (diff < 0 || diff > 25) return null;

                        if (mesiac > 12) return null;

                        if (den > 31) return null;

                        dietaInfo.datum = new Date(rok, mesiac - 1, den);
                    }
                }

                if (dietaInfo.datum == null) return null;
                var mes = dietaInfo.datum.getMonth() + 1;
                dietaInfo._monthBirth = dietaInfo.datum.getMonth() + 1;
                for (var i = 0; i < checked.length; i++) {
                    value = checked.eq(i).val();
                    switch (value) {
                        case "1":
                            monthGroups._1 = true;
                            break;
                        case "2":
                            monthGroups._2 = true;
                            break;
                        case "3":
                            monthGroups._3 = true;
                            break;
                        case "4":
                            monthGroups._4 = true;
                            break;
                        case "5":
                            monthGroups._5 = true;
                            break;
                        case "6":
                            monthGroups._6 = true;
                            break;
                        case "7":
                            monthGroups._7 = true;
                            break;
                        case "8":
                            monthGroups._8 = true;
                            break;
                        case "9":
                            monthGroups._9 = true;
                            break;
                        case "10":
                            monthGroups._10 = true;
                            break;
                        case "11":
                            monthGroups._11 = true;
                            break;
                        case "12":
                            monthGroups._12 = true;
                            break;
                    }
                    if (value == "1-12") {
                        dietaInfo._12 = true;
                        dietaInfo._1toBirth_2021 = 12;
                        dietaInfo._1to12_2022 = 12;
                        dietaInfo._1to3 = 3;
                        dietaInfo._4toBirth = 9;
                        break;
                    }
                    value = Number(value);
                    dietaInfo._1to12_2022++;
                    if (value <= mes) {
                        if (value <= 6) dietaInfo._1to6Birth_2022++;
                        else dietaInfo._7to12Birth_2022++;
                        dietaInfo._1toBirth_2022++;
                    } else {
                        if (value <= 6) dietaInfo._birthTo6_2022++;
                        else dietaInfo._birth7To12_2022++;
                        dietaInfo._birthTo12_2022++;
                    }
                    if (value <= 6) dietaInfo._1to6_2022++;
                    else dietaInfo._7to12_2022++;
                }

                return dietaInfo;
            }



            //GlobalFunction - vrat rozdiel datumov v rokoch
            function DateDiffInYears(dateold, datenew) {
                var ynew = datenew.getFullYear();
                var mnew = datenew.getMonth();
                var dnew = datenew.getDate();
                var yold = dateold.getFullYear();
                var mold = dateold.getMonth();
                var dold = dateold.getDate();
                var diff = ynew - yold;
                if (mold > mnew) diff--;
                else {
                    if (mold == mnew) {
                        if (dold > dnew) {
                            if (!(mold == 1 && mnew == 1 && dold == 29 && dnew == 28 && yold % 4 == 0)) {
                                diff--;
                            }
                        }
                    }
                }
                return diff;
            }

}

