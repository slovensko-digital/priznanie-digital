													</div>
													<div id="layoutRowContentlayoutRow41698" class="columns">

														<div id="layoutColumn103598" class="column first"  style="width:630px;">

															<div id="layoutCell168215" class="cell " >

																<span class="fieldLabel" title=""   style="width:610px;">
																	<xsl:text disable-output-escaping="yes">Zvýšenie (+) alebo zníženie (-) dane (r. 116 - r. 137) </xsl:text>
																</span>
