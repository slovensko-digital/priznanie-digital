function inlinecheckiban(element,sid) {
if ($("#" + element).val() == '')
        return 1;
    else {

        var iban = intern($("#" + element).val());
        var codeBank = iban.substring(4, 8);
        var invalidKodBanky = function () {
   var correctCode = true;
            $("#Skryte_pomocne_pole option").each(function () {
                if (Number(codeBank) == Number($(this).val())) {
